# ===================================================================
# 陆祺智控 · 集中监控平台 环境变量模板
#
# 用法：
#   cp .env.example .env
#   vi .env          # 填写下面标了【必填】的项
#   docker compose up -d
#
# 注意：.env 已被 .gitignore 排除，永远不要提交到仓库。
# ===================================================================

# ------------------------- MySQL（关系库）-------------------------
#【必填】MySQL root 密码。compose.yml 与后端/网关都读这一个变量。
#       密码里如果含 $ 或 # 请用单引号包起来，例如 MYSQL_ROOT_PWD='a$b#c'
MYSQL_ROOT_PWD=

# 数据库主机/端口（用 compose 内置 mysql 服务时保持默认）
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ------------------------- TDengine（时序库）------------------------
#【必填】TDengine root 密码
TDENGINE_PWD=
TD_USER=root
# REST 接口地址（compose 内置服务时保持默认）
TDENGINE_REST=http://tdengine:6041

# ------------------------- Redis -------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------- 认证 -------------------------
#【必填】JWT 签名密钥。随便填一串足够长的随机字符，例如：
#   openssl rand -hex 32
# 注意：改这个值会让所有已登录用户立刻掉线。
JWT_SECRET=

# 初始管理员账号（首次启动、用户表为空时自动创建；之后改这里不再生效）
ADMIN_USER=admin
ADMIN_PWD=

# ------------------------- 视频（ZLMediaKit）------------------------
# ZLM 的 API 地址与密钥（secret 在 ZLM 的 config.ini 里配置）
VIDEO_ZLM_URL=http://zlm:80
ZLM_SECRET=
# 视频播放 token 的独立密钥。留空则复用 JWT_SECRET
VIDEO_TOKEN_SECRET=
# 播放 token 有效期（秒）
VIDEO_TOKEN_TTL=3600

# ------------------------- 发布页（/publish）免登录访问 -------------------------
# 留空表示 /publish 不做 token 校验
PUBLISH_TOKEN=

# ------------------------- 多网关 -------------------------
# 网关标识：只允许 ASCII，首字符必须是字母或数字（不能填中文）
# 单网关部署时只保留一个即可；多网关按需展开成 GATEWAY_URL_<标识>
GATEWAY_ID=gw1
GATEWAY_PORT=8090
GATEWAY_URL=http://gateway:8090

# ------------------------- 采集与历史（网关侧）------------------------
# 历史入库的默认间隔（秒）。点位表里的 hist_interval 优先，为空时用这个值。
HIST_INTERVAL_DEFAULT=180
# 历史写入批次大小
HISTORY_BATCH=500
# 历史心跳：值长期不变时也强制落一条（秒）
HISTORY_HEARTBEAT=60
# 兼容旧配置的全局采样周期（秒），新部署请用 HIST_INTERVAL_DEFAULT
SAMPLE_INTERVAL=5
